<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stacje Pogodowe - WPF" Height="500" Width="750">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- górny panel filtrowanie i plik -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Wybierz stację (filtr): " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbFiltrStacja" Width="150" SelectionChanged="cmbFiltrStacja_SelectionChanged" Margin="0,0,20,0"/>

            <Button x:Name="btnWczytaj" Content="Wczytaj z pliku" Click="btnWczytaj_Click" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="btnZapisz" Content="Zapisz do pliku" Click="btnZapisz_Click" Width="100"/>
        </StackPanel>

        <!-- główna tabela -->
        <DataGrid x:Name="dgvPomiary" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stacja" Binding="{Binding Stacja}" Width="150"/>
                <DataGridTextColumn Header="Data i czas" Binding="{Binding DataCzas}" Width="160"/>
                <DataGridTextColumn Header="Temperatura (°C)" Binding="{Binding Temperatura}" Width="130"/>
                <DataGridTextColumn Header="Ciśnienie (hPa)" Binding="{Binding Cisnienie}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- dolny panel dodawanie pomiaru -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Stacja:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtStacja" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <TextBlock Text="Temp:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtTemperatura" Width="60" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <TextBlock Text="Ciśnienie:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtCisnienie" Width="60" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <Button x:Name="btnDodaj" Content="Dodaj pomiar" Click="btnDodaj_Click" Width="110"/>
        </StackPanel>
    </Grid>
</Window>